# AWS and Cognito — use an AWS profile or the laptop's normal AWS credential chain.
AWS_REGION=ap-southeast-7
DYNAMO_TABLE=robo-compet
COGNITO_USER_POOL_ID=ap-southeast-7_EXAMPLE
COGNITO_CLIENT_ID=example-client-id

# API served by this Ubuntu laptop.
PORT=3000
CORS_ORIGIN=https://competitive.skrc.suankularb.space
COMPETITION_API_URL=http://127.0.0.1:3000

# One normal Arduino UNO on lane 1. Replace the key with a random secret.
DEVICE_KEYS='{"uno-lane1":"replace-with-a-long-random-secret"}'
LANES='[{"laneId":"1","deviceId":"uno-lane1"}]'
UNO_DEVICE_ID=uno-lane1
UNO_LANE_ID=1
UNO_SERIAL_PORT=/dev/ttyACM0
SERIAL_SPOOL_DIR=.uno-spool

{
  "name": "skrc-competition-day-desktop",
  "productName": "SKRC Competition Day",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "npm run build && electron-forge start",
    "package:win": "npm run build && electron-forge package --platform=win32 --arch=x64",
    "make:win": "npm run build && electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@types/node": "^20.14.0",
    "electron": "43.4.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0"
  }
}

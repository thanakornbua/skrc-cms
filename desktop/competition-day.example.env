# Copy this file to competition-day.env beside the installed EXE, or edit the
# copy created under %APPDATA%\SKRC Competition Day on first launch.
AWS_PROFILE=default
AWS_REGION=ap-southeast-7
DYNAMO_TABLE=robo-compet
COGNITO_USER_POOL_ID=ap-southeast-7_REPLACE_ME
COGNITO_CLIENT_ID=REPLACE_ME

PORT=3210
CORS_ORIGIN=http://127.0.0.1:3210
API_BIND_HOST=127.0.0.1
DEVICE_KEYS='{"uno-lane1":"replace-with-a-long-random-secret"}'
LANES='[{"laneId":"1","deviceId":"uno-lane1"}]'
UNO_DEVICE_ID=uno-lane1
UNO_LANE_ID=1
# Leave blank to auto-detect an Arduino, or set e.g. COM3.
UNO_SERIAL_PORT=

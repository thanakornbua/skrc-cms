# Copy this file to competition-day.env beside the installed EXE, or edit the
# copy created under %APPDATA%\SKRC Competition Day on first launch.
# No AWS keys or profile here. The signed-in operator's Cognito session is
# exchanged for short-lived, role-scoped AWS credentials via this identity pool.
COGNITO_IDENTITY_POOL_ID=
AWS_REGION=ap-southeast-7
DYNAMO_TABLE=robo-compet
COGNITO_USER_POOL_ID=ap-southeast-7_REPLACE_ME
COGNITO_CLIENT_ID=REPLACE_ME

PORT=7070
CORS_ORIGIN=http://127.0.0.1:7070
API_BIND_HOST=127.0.0.1
DEVICE_KEYS='{"uno-lane1":"replace-with-a-long-random-secret"}'
LANES='[{"laneId":"1","deviceId":"uno-lane1"}]'
UNO_DEVICE_ID=uno-lane1
UNO_LANE_ID=1
# Leave blank to auto-detect an Arduino, or set e.g. COM3.
UNO_SERIAL_PORT=

# OBS overlay. The application writes SKRC_StageName.txt, SKRC_TeamName.txt and
# SKRC_ElapsedTime.txt for OBS "Read from file" text sources. Leave OBS_OUT_DIR
# blank for %APPDATA%\SKRC Competition Day\obs. Set OBS_OVERLAY=off to skip it.
OBS_OVERLAY=on
OBS_OUT_DIR=
